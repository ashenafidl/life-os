{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && pnpm build:db-scripts",
    "build:db-scripts": "esbuild src/db/migrate.ts src/db/seed.ts --bundle --platform=node --outdir=dist/db --format=cjs --external:pg-native",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck",
    "check:all": "pnpm run check && pnpm run build",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-table": "^8.21.3",
    "bonjour-service": "^1.4.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-hotkeys-devtools": "^0.7.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,scss}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
